# eslint-plugin-react@7.37.5 (the current release) declares a peer range of
# `eslint: ^3 || ... || ^9.7`, so npm's strict resolver rejects this project's
# eslint 10 and `npm install` / `npm ci` fail outright on a fresh clone.
#
# typescript-eslint, eslint-plugin-react-hooks and eslint-plugin-react-refresh
# all support eslint 10; only eslint-plugin-react is behind. Until it catches up,
# relax peer resolution so installs are reproducible.
legacy-peer-deps=true

# Keep the lockfile and installs deterministic across machines.
save-exact=false
fund=false
audit=false
